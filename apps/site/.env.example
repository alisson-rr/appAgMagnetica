# Endereço público do aplicativo. Usado por todos os CTAs do site (entrar, cadastro, planos).
VITE_APP_URL=http://localhost:3000

# Endpoint seguro que recebe os dados do formulário. Nunca coloque chaves privadas no navegador.
VITE_LEAD_WEBHOOK_URL=

# Alternativa: número com DDI e DDD, somente dígitos. Abre uma conversa se não houver webhook.
VITE_WHATSAPP_NUMBER=
