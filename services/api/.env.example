SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=substitua-e-mantenha-apenas-no-backend
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:3000,https://app.seudominio.com.br
# Token de maquina das rotas /api/ai/*, enviado no header X-Automation-Token.
# Minimo de 32 caracteres; vazio faz as rotas da automacao recusarem tudo.
# NAO reutilize o JWT do painel nem a chave do Supabase.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMATION_API_TOKEN=gere-um-segredo-longo-e-aleatorio
# Redação e memória no backend; a interpretação continua no modelo do n8n.
# Sem chave, a redação usa a resposta de reserva e o resumo permanece na fila.
OPENAI_API_KEY=
AI_WRITER_MODEL=gpt-5.4
AI_MEMORY_MODEL=gpt-5-mini-2025-08-07
AI_REVIEW_MODEL=gpt-5-mini-2025-08-07
EVOLUTION_BASE_URL=https://sua-evolution.example.com
EVOLUTION_API_KEY=substitua-e-mantenha-apenas-no-backend
# O caminho e o do no Webhook do workflow atual
# (automation/n8n/AgendaMagnetica-v2.n8n.json, path "agenda-magnetica-v2").
EVOLUTION_WEBHOOK_URL=https://seu-n8n.example.com/webhook/agenda-magnetica-v2
EVOLUTION_WEBHOOK_HEADER_NAME=x-agenda-magnetica-token
EVOLUTION_WEBHOOK_SECRET=gere-um-segredo-longo-e-aleatorio
# DATABASE_URL e usada SOMENTE pelos testes que falam com o banco. Nao entra
# neste exemplo com valor: e a string de conexao direta do Postgres.
#
# PERMITIR_TESTES_DE_BANCO: NAO defina no .env. E uma autorizacao explicita de
# quem roda, exportada no ambiente do processo. Sem ela,
# tests/test_ai_api_integracao.py e ignorado em vez de ESCREVER (com commit) no
# banco apontado por DATABASE_URL:
#   PERMITIR_TESTES_DE_BANCO=1 services/api/.venv/Scripts/python -m pytest services/api/tests
